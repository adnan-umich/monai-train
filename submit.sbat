#!/bin/bash

#SBATCH --nodes=1
#SBATCH --partition=spgpu
#SBATCH --gpus=1
#SBATCH --time=4:05:00
#SBATCH --mem=20GB
#SBATCH --cpus-per-gpu=4

cd /home/adnanzai/monai-train
ml purge
module load python/3.11 poetry

poetry run monai-train --data=./sample --output=./output --split=0.8 --lr=0.0001 --epochs=500 --batch=1 --seed=0 --savemodel=True --model=/home/adnanzai/monai-train/example/model_unet.yaml

